# 部署到 Vercel 时，请把这个文件里的占位值填到 Vercel 项目 → Settings → Environment Variables
# （本地开发则复制为 .env）

# —— AI 问答 / 一键解盘 / 早报 ——
INFINISYNAPSE_API_KEY=
INFINISYNAPSE_SERVER_URL=https://app.infinisynapse.cn

# 兜底大模型（可选）
DEEPSEEK_API_KEY=

# —— InfiniSynapse Partner SSO 登录（可选，未配置则登录接口提示未配置）——
INFINI_CLIENT_ID=
INFINI_CLIENT_SECRET=
INFINI_SSO_API_BASE=https://api.infinisynapse.cn/api

# 登录成功后浏览器跳回的完整地址，域名必须与申请时白名单一致，例如：
# https://www.pixiepoppy.com/auth/callback
PAOPAO_SSO_RETURN_URL=https://www.pixiepoppy.com/auth/callback

# 端口（本地自托管用；Vercel 由平台分配，无需设置）
# PORT=8080
